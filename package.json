          </div>
        </div>

        {/* Product Details */}
        <div>
          <div className="text-sm uppercase tracking-[0.35em] text-taupe">
            {product.category.replace(/-/g, " ")}
          </div>

          <h1 className="mt-4 font-serif text-4xl md:text-5xl font-semibold">
